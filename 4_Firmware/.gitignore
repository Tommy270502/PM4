*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf


# STM32CubeIDE specific files
# Source: https://github.com/github/gitignore/blob/main/Global/STM32CubeIDE.gitignore

# Project-specific settings. Ignore it if developers have different preferences
# However, if you want all team members to use the same code formatting and settings, 
# consider including the .settings folder in the repository

# /.settings/
# Ignore code style and formatting settings (changes every time)
language.settings.xml

# Eclipse-based IDE launch configurations
# Uncomment if you want each developer to have their own unique debug configurations
*.launch

# JLink-related files (debug configurations)
# Uncomment if you want each developer to have their own unique debug configurations
#*.jlink

# Log files generated by the IDE
*.log

# Build output directories
Debug/
Release/

# Common binary and object files generated during compilation
*.bin
*.srec
*.lst
*.list
*.a
*.crl
*.cyclo

# TouchGFX files (in case your project has touchGFX)
TouchGFX/generated
TouchGFX/build
TouchGFX/simulator/msvs/.vs

# Backup files
*.bak
