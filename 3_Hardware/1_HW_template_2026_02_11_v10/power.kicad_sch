	(text "LDO Calculations\n\nVoltage drop across regulator\ndV = Vin - Vout\ndV = 5 - 3.3\ndV = 1.7 V\n\nPower dissipation\nP = dV * Io\n\nThermal limits (SOT-223)\n\nRθJA = 110 °C/W\nTambient = 20 °C\nTallowed = 50 °C\n\nAllowed temperature rise\nΔT = Tallowed - Tambient\nΔT = 50 - 20\nΔT = 30 °C\n\nMaximum allowed power dissipation\nPmax = ΔT / RθJA\nPmax = 30 / 110\nPmax ≈ 0.273 W\n\nMaximum output current\n\nIo(max) = Pmax / dV\nIo(max) = 0.273 / 1.7\nIo(max) ≈ 0.160 A\n"
		(exclude_from_sim no)
		(at 55.88 94.488 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
		)
		(uuid "1e93eb1f-8ab1-4a67-b201-4ef0d4d85032")
	)
